    /**
     * The method LoadPCSV() loads the csv file that contains employee payslips
     */
    public void LoadPCSV(){
        String path = "Payslip.csv";

        String line = "";
        boolean firstLine =true;

        try {
            BufferedReader PayslipReader = new BufferedReader(new FileReader(path));

            Payslip ps = null;
            while ((line = PayslipReader.readLine()) != null) {
                if (firstLine) {
                    firstLine = false;
                    continue;
                }
                String[] values = line.split(",");

                if (values.length == 11) {
                    String employeeID = values[0];

                    employeeIDList.add(employeeID);
                    String name = values[1];
                    String position = values[2];
                    double grossMonthlyPay = Double.parseDouble(values[3]);
                    double prsi = Double.parseDouble(values[4]);
                    double usc = Double.parseDouble(values[5]);
                    double incomeTax = Double.parseDouble(values[6]);
                    double healthInsurance = Double.parseDouble(values[7]);
                    double unionContribution = Double.parseDouble(values[8]);
                    double netPay = Double.parseDouble(values[9]);

                    String dateString = values[10];
                    String[] dateParts = dateString.split("/");
                    int day = Integer.parseInt(dateParts[0]);
                    int month = Integer.parseInt(dateParts[1]);
                    int year = Integer.parseInt(dateParts[2]);
                    LocalDate date = LocalDate.of(year, month, day);

                    ps = new Payslip(employeeID, name, position, grossMonthlyPay, prsi,
                            usc, incomeTax, healthInsurance, unionContribution, netPay, date);

                    payslips.add(ps);

                }
            }
            System.out.println("PCSV Loaded");
        } catch (FileNotFoundException e) {
            System.out.println("Incorrect path name used");
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    /**
     * The method prints the payslip for a given employee
     * @param employeeID The payslip object to print
     */
    public void printPayslip(String employeeID, LocalDate date) {
        this.employee = null; //reset
        admin.loadCSV();
        LoadPCSV();

        //check if employees arrayList is null
        if (admin.getEmployees().isEmpty()) {
            System.out.println("Employees list is empty.");
            return;
        }

        //find employee using id number
        for (Employee emp : admin.getEmployees()) {
            if (emp.getEmployeeID().trim().equals(employeeID.trim())) {
                this.employee = emp;
                break;
            }
        }

        //case where employee not found
        if (employee == null) {
            System.out.println("Employee not found. Cannot print payslip.");
            return;
        }

        //check if payslip arrayList is null
        if(getPayslips().isEmpty()){
            System.out.println("Payslip list is empty.");
        }

        boolean payslipExists = false;
        Payslip employeePayslip = null;
        // Find the payslip for the employee
        for (Payslip ps : getPayslips()) {
            if (ps.getEmployeeID().equals(this.employee.getEmployeeID()) && ps.getDate().equals(date)) {
                employeePayslip = ps;
                payslipExists = true;
                break;
            }
            else {
                employeePayslip = null;
            }
        }
        
       if(payslipExists) {
           // Print header
           System.out.printf("Payslip for %s (%s) dated %s\n", employeePayslip.getName(), employeePayslip.getEmployeeID(), employeePayslip.getDate());

           // Print gross pay and deductions
           System.out.println("*************************");
           System.out.printf("Gross pay: %.2f\n", employeePayslip.getGrossMonthlyPay());
           System.out.println("*************************");
           System.out.println("DEDUCTIONS:");
           System.out.printf("PRSI: %.2f\n", employeePayslip.getPrsi());
           System.out.printf("USC: %.2f\n", employeePayslip.getUsc());
           System.out.printf("Income Tax: %.2f\n", employeePayslip.getIncomeTax());
           System.out.printf("Health Insurance: %.2f\n", employeePayslip.getHealthInsurance());
           System.out.printf("Union Contribution: %.2f\n", employeePayslip.getUnionContribution());
           System.out.println("*************************");

           // Print net pay
           System.out.printf("NET PAY: %.2f\n", employeePayslip.getNetPay());
       }else{
           System.out.printf("No payslip found for %s dated %s\n", this.employee.getName(), date);
       }
    }


    /**
     * The method updatePCSV() writes to the csv file of employee payslips
     */
    public void updatePCSV () {
        Deductions deductions = new Deductions(employee);
        String filePath = "Payslip.csv";
        try (BufferedWriter Payslipwriter= new BufferedWriter(new FileWriter(filePath))) {
            // Write the header row (if needed)
            try {
                Payslipwriter.write("ID, Name, Position, GrossMonthlyPay, PRSI, USC, IncomeTax,Health Isurance,Union Contribution,Net Pay, Date");
            } catch (IOException e) {
                throw new RuntimeException(e);
            }
            Payslipwriter.newLine();

            // Iterate through the list of employees and write each employee's data
            for (Employee employee : admin.employees){
                for (Payslip payslip: payslips){
                    DateTimeFormatter dateFormatter = DateTimeFormatter.ofPattern("dd/MM/yyyy");
                    Payslipwriter.write(
                            employee.getEmployeeID() + "," +
                                    employee.getName() + "," +
                                    employee.getPosition() + "," +
                                    deductions.grossMonthlyPay() + "," +
                                    deductions.PRSI() + "," +
                                    deductions.USC() + "," +
                                    deductions.incomeTax() + "," +
                                    HealthInsurance + "," +
                                    UnionContribution + "," +
                                    deductions.netPay() + "," +
                                    todaysDate + "\n"
                    );
                }

            }

            System.out.println("CSV file updated successfully.");

        } catch (IOException e) {
            System.out.println("Error writing to the CSV file: " + e.getMessage());
        }
    }

